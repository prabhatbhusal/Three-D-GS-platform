PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Shared editor password until real accounts exist (Postgres "not started" per CLAUDE.md).
EDITOR_PASSWORD=change-me

# Long random strings in real environments — these sign session + embed tokens.
SESSION_SECRET=change-me-too
EMBED_TOKEN_SECRET=change-me-as-well

# Where uploaded splats are kept (src/storage.js).
#   local  this PC's disk (ASSET_DIR). Only this PC can show them.
#   s3     one cloud bucket (Cloudflare R2, Backblaze B2, AWS S3, …) that every
#          PC and the hosted API share, so a splat uploaded anywhere shows
#          everywhere. Copy existing uploads up with: npm run assets:push
ASSET_DRIVER=local
ASSET_DIR=./src/data/assets

# For ASSET_DRIVER=s3. Cloudflare R2: dashboard → R2 → create a bucket, then
# "Manage R2 API tokens" → Object Read & Write. The endpoint is
# https://<account-id>.r2.cloudflarestorage.com and the region is auto.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: keys go under this folder in the bucket (default assets/).
# S3_PREFIX=assets/

# Texts to guests (booking confirmations, waitlist news), besides email.
# Each is off until its keys are set; set one or both.
# SMS, through Sparrow SMS (sparrowsms.com): the token and sender identity from its dashboard.
SMS_TOKEN=
SMS_FROM=
# WhatsApp, through Meta's WhatsApp Cloud API (developers.facebook.com → WhatsApp):
# a permanent token, the sending number's id, and an approved message template
# with one {{1}} in its body. Meta lets a business message a guest first only
# through a template; without one, only guests who wrote within 24 h get it.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
# WHATSAPP_LANG=en
# The country code for phone numbers guests type without one.
# PHONE_COUNTRY=977

# The AI concierge in the tour: visitors ask questions and get answers from the
# project's published information (brand info, website, menu, rooms, spaces).
# Off until a key is set. From console.anthropic.com.
ANTHROPIC_API_KEY=
# The model: the most capable by default; claude-haiku-4-5-20251001 costs less.
# CONCIERGE_MODEL=claude-opus-5-5

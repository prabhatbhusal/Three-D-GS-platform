PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Shared editor password until real accounts exist (Postgres "not started" per CLAUDE.md).
EDITOR_PASSWORD=change-me

# Long random strings in real environments — these sign session + embed tokens.
SESSION_SECRET=change-me-too
EMBED_TOKEN_SECRET=change-me-as-well

# Asset storage driver seam (CLAUDE.md §9). Local disk today; only ASSET_DIR
# is read by storage.js right now — ASSET_DRIVER exists for when an s3 driver
# is added, so switching is one env var, not a code change.
ASSET_DRIVER=local
ASSET_DIR=./src/data/assets
